+            for b in bodies
+        )
+        assert all(f"call-{i}" in json.dumps(bodies[-1]) for i in range(1, 4))
+        assert json.dumps(bodies[-1]).count("evidence") == 3
+    finally:
+        asyncio.run(client.aclose())

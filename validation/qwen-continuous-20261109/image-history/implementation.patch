+def test_recent_images_reach_serialized_provider_body(tmp_path, enabled):
+    import base64
+
+    import httpx2
+    from pydantic_ai.models.openai import OpenAIChatModel
+    from pydantic_ai.providers.openai import OpenAIProvider
+
+    bodies = []
+    events = Events()
+    toolkit = RobotToolkit(events)
+    sequence = iter([b"image1", b"image2", b"image3"])
+    toolkit.register(
+        "observe",
+        lambda: ToolResult(data={"keep": "evidence"}, images=[next(sequence)]),
+    )
+
+    def respond(request):
+        bodies.append(json.loads(request.content))
+        count = len(bodies)
+        name = "observe" if count <= 3 else "finish"
+        chunk = {
+            "id": f"offline-{count}",
+            "object": "chat.completion.chunk",
+            "created": 1,
+            "model": "qwen3.8-flash",
+            "choices": [
+                {
+                    "index": 0,
+                    "finish_reason": "tool_calls",
+                    "delta": {
+                        "role": "assistant",
+                        "tool_calls": [
+                            {
+                                "index": 0,
+                                "id": f"call-{count}",
+                                "type": "function",
+                                "function": {
+                                    "name": name,
+                                    "arguments": json.dumps(
+                                        FINISH_ARGS if name == "finish" else {}
+                                    ),
+                                },
+                            }
+                        ],
+                    },
+                }
+            ],
+        }
+        return httpx2.Response(
+            200,
+            headers={"content-type": "text/event-stream"},
+            content=f"data: {json.dumps(chunk)}\n\ndata: [DONE]\n\n".encode(),
+        )
+
+    client = httpx2.AsyncClient(transport=httpx2.MockTransport(respond))
+    model = OpenAIChatModel(
+        "qwen3.8-flash",
+        provider=OpenAIProvider(
+            base_url="https://example.invalid/v1",
+            api_key="offline-test",
+            http_client=client,
+        ),
+    )
+    try:
+        result, _, _ = solve(
